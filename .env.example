# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public site URL used in OAuth redirects and invite links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Telegram personal donor alerts
# 1) @BotFather → bot token
# 2) Run supabase/donor-telegram.sql in Supabase SQL Editor
# 3) Donors tap "Get Telegram alerts" on the landing page
# 4) On Vercel: Project → Settings → Environment Variables → add the same
#    TELEGRAM_* / NEXT_PUBLIC_TELEGRAM_* keys for Production, then Redeploy.
#    (.env.local is never deployed.)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token
# Optional — auto-detected from getMe if empty
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHANNEL_ID=
NEXT_PUBLIC_TELEGRAM_CHANNEL_URL=

# Twilio WhatsApp (optional — post-match chat / legacy)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
