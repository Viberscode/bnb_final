# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public site URL used in OAuth redirects and invite links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Telegram live-request alerts (BotFather token + channel the bot can post to)
# 1) Create a bot with @BotFather → copy token
# 2) Create a public channel → add the bot as admin with Post messages
# 3) TELEGRAM_CHANNEL_ID = @your_channel_username  OR numeric -100xxxxxxxxxx
# 4) NEXT_PUBLIC_TELEGRAM_CHANNEL_URL = https://t.me/your_channel_username
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token
TELEGRAM_CHANNEL_ID=@your_bloodnearby_channel
NEXT_PUBLIC_TELEGRAM_CHANNEL_URL=https://t.me/your_bloodnearby_channel

# Twilio WhatsApp (optional — post-match chat / legacy)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
