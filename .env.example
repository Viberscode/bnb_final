# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: site URL used in OAuth redirects
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Twilio WhatsApp (Console → Account SID / Auth Token, and a WhatsApp-enabled sender)
# Sandbox: Messaging → Try it out → Send a WhatsApp message. Recipients must join the sandbox first.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
